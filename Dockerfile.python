FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY shared ./shared
COPY grid_engine ./grid_engine
COPY orchestrator ./orchestrator
COPY data/opsd_replay.json ./data/opsd_replay.json
ENV GRID_SOURCE=live AGENT_SOURCE=live GRID_DATA_MODE=public
EXPOSE 8001
CMD ["python", "-m", "uvicorn", "grid_engine.api:app", "--host", "0.0.0.0", "--port", "8001"]
